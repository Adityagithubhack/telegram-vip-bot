ENVIRONMENT=development
LOG_LEVEL=INFO

BOT_TOKEN=replace_with_your_bot_token

BOT_MODE=polling

WEBHOOK_BASE_URL=
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=replace_with_a_long_random_secret

DATABASE_URL=postgresql+asyncpg://telegram_vip:telegram_vip_dev_password@localhost:5432/telegram_vip
REDIS_URL=redis://localhost:6379/0

SUPER_ADMIN_TELEGRAM_ID=

# White-label branding
BRAND_NAME=YOUR SPORTS BRAND
ADMIN_BRAND_NAME=YOUR BRAND ADMIN
REQUIRED_CHANNEL_USERNAME=
REQUIRED_CHANNEL_INVITE_URL=

# Client-specific Docker setup
COMPOSE_PROJECT_NAME=telegram_vip_client
POSTGRES_DB=telegram_vip
POSTGRES_USER=telegram_vip
POSTGRES_PASSWORD=change_this_password
POSTGRES_PORT=5432
REDIS_PORT=6379
